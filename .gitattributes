* text=auto
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary

# TipTap bundles are generated. A template literal intentionally ends a line with two spaces
# to emit a Markdown hard break, so blank-at-eol is semantic in these generated chunks.
scripts/vendor/tiptap/chunks/*.js whitespace=-blank-at-eol
